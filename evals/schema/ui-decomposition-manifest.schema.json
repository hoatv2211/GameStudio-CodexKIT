{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/ui-decomposition-manifest.schema.json",
  "title": "Flattened Unity UI screenshot decomposition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "assets", "backgrounds", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"$ref": "#/$defs/source"},
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "backgrounds": {
      "type": "array",
      "items": {"$ref": "#/$defs/background"}
    },
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_. -]+(?:/[A-Za-z0-9_. -]+)*$"
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "decision", "bbox", "confidence", "reason", "review_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "decision": {"enum": ["raster", "native-ui", "background", "discard"]},
        "bbox": {"$ref": "#/$defs/bbox"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "review_status": {"enum": ["pending", "approved", "rejected"]},
        "output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "bbox", "review_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "kind": {"enum": ["code-overlay", "raster-overlay"]},
        "bbox": {"$ref": "#/$defs/bbox"},
        "review_status": {"enum": ["pending", "approved", "rejected"]}
      }
    },
    "restoration_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "role": {"enum": ["raw-full", "local-composite"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "bbox", "baked_visuals", "overlays", "restoration_variants", "selected_variant", "review_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "baked_visuals": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "overlays": {"type": "array", "items": {"$ref": "#/$defs/overlay"}},
        "restoration_variants": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/restoration_variant"}
        },
        "selected_variant": {"enum": ["raw-full", "local-composite"]},
        "review_status": {"enum": ["pending", "approved", "rejected"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at"],
      "properties": {
        "status": {"const": "approved"},
        "reviewer": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
