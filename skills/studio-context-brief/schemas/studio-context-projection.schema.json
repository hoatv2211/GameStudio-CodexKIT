          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "count": {
            "const": 0
          },
          "text": {
            "const": ""
          },
          "evidence_label": {
            "const": "BLOCKED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          },
