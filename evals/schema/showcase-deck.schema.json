{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/showcase-deck.schema.json",
  "title": "Game screenshot showcase deck",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deck_id",
    "source_capture_id",
    "source_capture_sha256",
    "source_capture_review",
    "outcome",
    "message",
    "crop",
    "focal",
    "layout",
    "locale",
    "direction",
    "alt_text",
    "approval"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "deck_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_capture_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_capture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_capture_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at"],
      "properties": {
        "status": {"const": "approved"},
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        }
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "exclusiveMinimum": 0},
        "height": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "focal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "radius"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "radius": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "frame", "caption_position", "safe_area"],
      "properties": {
        "background": {"enum": ["stone", "parchment", "dark", "neutral"]},
        "frame": {"enum": ["desktop", "mobile", "tablet", "canvas"]},
        "caption_position": {"enum": ["top", "bottom"]},
        "safe_area": {"type": "boolean"}
      }
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "direction": {"enum": ["ltr", "rtl"]},
    "alt_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "approved_at"],
      "properties": {
        "status": {"const": "approved"},
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        },
        "approved_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        }
      }
    }
  }
}
