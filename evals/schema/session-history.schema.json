{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "workflow",
          "outcome",
          "evidence_label",
          "retry_count",
          "unauthorized_write",
          "manual_pattern"
        ],
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "workflow": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["PASS", "FAIL", "BLOCKED"]},
          "evidence_label": {"enum": ["Verified", "Snapshot", "Unverified", "BLOCKED"]},
          "retry_count": {"type": "integer", "minimum": 0},
          "unauthorized_write": {"type": "boolean"},
          "manual_pattern": {"type": "string"}
        }
      }
    }
  }
}
