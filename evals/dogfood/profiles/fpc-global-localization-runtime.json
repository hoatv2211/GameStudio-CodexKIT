{
  "schema_version": 1,
  "id": "fpc-global-localization-runtime",
  "description": "FPC static localization certification plus mandatory Unity MCP and Play Mode evidence.",
  "project": {
    "name": "FlyingPhoenixChronicles",
    "kind_matchers": ["Flying Phoenix Chronicles", "Unity MMORPG"]
  },
  "case_ids": ["fpc-global-residue-authority", "fpc-localization-doctor", "fpc-unity-localization-runtime"],
  "cases": [
    {
      "id": "fpc-global-residue-authority",
      "workflow": "global-residue-authority-audit",
      "project_kind": "Flying Phoenix Chronicles",
      "prompt": "Audit current Unity prefab, catalog, Lua, and evidence authority for Global English residue without mutation.",
      "required_artifacts": ["command-log", "project-snapshot", "localization-report", "verdict"],
      "allow_mutation": false
    },
    {
      "id": "fpc-localization-doctor",
      "workflow": "localization-authority-audit",
      "project_kind": "Flying Phoenix Chronicles",
      "prompt": "Run the strict available localization audit and static localization tests, recording source/catalog/overlay limitations.",
      "required_artifacts": ["command-log", "project-snapshot", "doctor-report", "verdict"],
      "allow_mutation": false
    },
    {
      "id": "fpc-unity-localization-runtime",
      "workflow": "unity-localization-runtime-verification",
      "project_kind": "Flying Phoenix Chronicles Unity client",
      "prompt": "Verify active Unity localization text, console output, and target-resolution overflow through fresh Unity MCP and Play Mode evidence.",
      "required_artifacts": [
        "command-log",
        "project-snapshot",
        "runtime-audit",
        "mcp-transcript",
        "editor-state",
        "editmode-result",
        "playmode-result",
        "console-report",
        "runtime-assertion",
        "verdict"
      ],
      "required_mcp_operations": [
        {
          "artifact_kind": "editor-state",
          "tool": "read_mcp_resource",
          "operation": "mcpforunity://editor/state"
        },
        {
          "artifact_kind": "editmode-result",
          "tool": "run_tests",
          "operation": "EditMode"
        },
        {
          "artifact_kind": "editmode-result",
          "tool": "get_test_job",
          "operation": "EditMode"
        },
        {
          "artifact_kind": "playmode-result",
          "tool": "run_tests",
          "operation": "PlayMode"
        },
        {
          "artifact_kind": "playmode-result",
          "tool": "get_test_job",
          "operation": "PlayMode"
        },
        {
          "artifact_kind": "console-report",
          "tool": "read_console",
          "operation": "get"
        },
        {
          "artifact_kind": "runtime-assertion",
          "tool": "execute_code",
          "operation": "execute"
        }
      ],
      "allow_mutation": false
    }
  ],
  "runner_capabilities": ["file-audit", "unity-mcp", "play-mode"],
  "runtime_targets": ["Codex App/CLI"],
  "max_evidence_age_days": 7,
  "artifact_root_policy": "kit-evidence-local",
  "promotion_scope": ["unity-ui-rendering-debugging", "localization-authority-audit"]
}
