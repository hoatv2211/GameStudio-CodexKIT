{
  "$comment": "Generated by scripts/sync_skill_resources.py. Do not edit manually.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/ui-design-brief.schema.json",
  "title": "Unity UI design brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_revision",
    "goal",
    "format",
    "layout",
    "type_system",
    "color_material",
    "imagery",
    "copy",
    "constraints",
    "variants",
    "owner",
    "reviewer"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen",
        "audience",
        "success_criteria"
      ],
      "properties": {
        "screen": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "scale",
        "safe_margins"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "safe_margins": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "items": false
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid",
        "hierarchy"
      ],
      "properties": {
        "grid": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "hierarchy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "type_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font_family",
        "font_weights",
        "leading",
        "tracking"
      ],
      "properties": {
        "font_family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "font_weights": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 900
          }
        },
        "leading": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tracking": {
          "type": "number"
        }
      }
    },
    "color_material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "text",
        "accent",
        "texture"
      ],
      "properties": {
        "background": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accent": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "texture": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "imagery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_lane",
        "reference_ids",
        "material_language"
      ],
      "properties": {
        "style_lane": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "material_language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines",
        "text_policy"
      ],
      "properties": {
        "lines": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "text_policy": {
          "enum": [
            "typeset-in-figma",
            "runtime-localized",
            "none"
          ]
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_keep",
        "change_only",
        "negative"
      ],
      "properties": {
        "must_keep": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "change_only": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "negative": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "change",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "change": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "candidate",
              "approved",
              "rejected"
            ]
          }
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
