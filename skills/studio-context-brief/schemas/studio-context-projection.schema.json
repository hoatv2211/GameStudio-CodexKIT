          }
        },
        "required": [
          "projection"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "const": 150
          },
          "hard_cap": {
            "const": 300
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projection": {
            "const": "working"
          }
        },
        "required": [
          "projection"
        ]
      },
