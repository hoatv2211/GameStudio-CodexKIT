      "minimum": 0
    },
    "target": {
      "type": "integer",
      "minimum": 0
    },
    "hard_cap": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string"
    },
    "required_fact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence_label": {
      "enum": [
        "Verified",
        "Snapshot",
        "Unverified",
        "BLOCKED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        },
        "required": [
