{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/dogfood-result.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "workflow", "verdict", "evidence_label"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
      "workflow": {"type": "string", "pattern": "^[a-z0-9-]+$"},
      "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]},
      "evidence_label": {"enum": ["Verified", "Snapshot", "Unverified", "BLOCKED"]},
      "command": {"type": "string"},
      "exit_code": {"type": "integer"},
      "artifacts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "path": {"type": "string", "minLength": 1}
          }
        }
      },
      "project_snapshot": {"type": "string"},
      "reviewer": {"type": "string"},
      "timestamp": {"type": "string", "format": "date-time"},
      "unauthorized_write": {"type": "boolean"},
      "restore": {"type": "string"},
      "reason": {"type": "string"}
    }
  }
}
