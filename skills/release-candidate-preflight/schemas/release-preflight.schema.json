{
  "$comment": "Generated by scripts/sync_skill_resources.py. Do not edit manually.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/release-preflight.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "checks",
    "defects",
    "waivers"
  ],
  "properties": {
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/defect"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiver"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "checkEvidenceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "candidate_id",
        "candidate_version",
        "source_snapshot",
        "build_id",
        "primary_artifact_sha256",
        "check_id",
        "kind",
        "command",
        "exit_code",
        "timestamp",
        "owner",
        "status",
        "details"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_version": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot": {
          "type": "string",
          "minLength": 7
        },
        "build_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "check_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "details": {
          "type": "object"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "source_snapshot",
        "build_id",
        "primary_artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{5,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "source_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        },
        "build_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{2,127}$"
        },
        "primary_artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "decision",
        "timestamp"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "const": "APPROVED"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidate_id",
        "source_snapshot",
        "build_id",
        "primary_artifact_sha256",
        "status",
        "command",
        "exit_code",
        "timestamp",
        "owner",
        "artifacts",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        },
        "build_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "const": 0
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "artifacts": {
                "minItems": 1
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "FAIL",
                  "BLOCKED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "monitoring"
              },
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "id",
              "status"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "signals",
                  "alert_routes",
                  "validation_command"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "signals": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "alert_routes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "validation_command": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "rollback"
              },
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "id",
              "status"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "target",
                  "trigger",
                  "command",
                  "validation_command"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trigger": {
                    "type": "string",
                    "minLength": 1
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "validation_command": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "approvals"
              },
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "id",
              "status"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "approvers"
                ],
                "properties": {
                  "approvers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/approval"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "summary",
        "resolved_at",
        "verification_command",
        "verification_exit_code",
        "artifact"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        },
        "verification_command": {
          "type": "string",
          "minLength": 1
        },
        "verification_exit_code": {
          "const": 0
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidate_id",
        "severity",
        "status",
        "owner",
        "summary",
        "blocks_release"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "status": {
          "enum": [
            "OPEN",
            "RESOLVED"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "blocks_release": {
          "type": "boolean"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "severity": {
                "enum": [
                  "P1",
                  "P2"
                ]
              },
              "status": {
                "const": "RESOLVED"
              }
            },
            "required": [
              "severity",
              "status"
            ]
          },
          "then": {
            "required": [
              "resolution"
            ]
          }
        }
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "defect_id",
        "candidate_id",
        "approved_by",
        "reason",
        "scope",
        "mitigation",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "defect_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
