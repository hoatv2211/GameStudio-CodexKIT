{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/store-export-manifest.schema.json",
  "title": "Game screenshot store export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "platform",
    "requirement_snapshot",
    "locale",
    "device",
    "outputs",
    "source_capture_ids",
    "missing_slots",
    "rejected_slots",
    "reviewer",
    "human_approval"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "platform": {"enum": ["steam", "android", "ios", "webgl"]},
    "requirement_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "captured_at", "reference"],
      "properties": {
        "source": {"const": "store-submission-checklist"},
        "captured_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        }
      }
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "width", "height", "scale", "format"],
      "properties": {
        "preset": {
          "enum": [
            "desktop-hd",
            "desktop-4k",
            "mobile-portrait-1080x1920",
            "webgl-1080p"
          ]
        },
        "width": {"type": "integer", "exclusiveMinimum": 0},
        "height": {"type": "integer", "exclusiveMinimum": 0},
        "scale": {"type": "integer", "minimum": 1},
        "format": {"enum": ["png", "jpg"]}
      }
    },
    "outputs": {
      "$comment": "Semantic uniqueness for output slot assignment is enforced by scripts.screenshot_showcase.build_store_export_manifest.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    },
    "source_capture_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "missing_slots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
      }
    },
    "rejected_slots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at"],
      "properties": {
        "status": {"const": "approved"},
        "approved_by": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        },
        "approved_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "device": {"properties": {"preset": {"const": "desktop-hd"}}, "required": ["preset"]}
        },
        "required": ["device"]
      },
      "then": {
        "properties": {
          "device": {
            "properties": {
              "width": {"const": 1920},
              "height": {"const": 1080},
              "format": {"const": "png"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {"properties": {"preset": {"const": "desktop-4k"}}, "required": ["preset"]}
        },
        "required": ["device"]
      },
      "then": {
        "properties": {
          "device": {
            "properties": {
              "width": {"const": 3840},
              "height": {"const": 2160},
              "format": {"const": "png"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {
            "properties": {"preset": {"const": "mobile-portrait-1080x1920"}},
            "required": ["preset"]
          }
        },
        "required": ["device"]
      },
      "then": {
        "properties": {
          "device": {
            "properties": {
              "width": {"const": 1080},
              "height": {"const": 1920},
              "format": {"const": "png"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {"properties": {"preset": {"const": "webgl-1080p"}}, "required": ["preset"]}
        },
        "required": ["device"]
      },
      "then": {
        "properties": {
          "device": {
            "properties": {
              "width": {"const": 1920},
              "height": {"const": 1080},
              "format": {"const": "png"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*))*$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "path", "sha256", "bytes", "source_capture_id"],
      "properties": {
        "slot": {"enum": ["hero", "detail", "thumbnail", "portrait"]},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "exclusiveMinimum": 0},
        "source_capture_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    }
  }
}
