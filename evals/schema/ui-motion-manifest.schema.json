{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/ui-motion-manifest.schema.json",
  "title": "Unity UI motion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ui_stack", "source_revision", "motions"],
  "properties": {
    "schema_version": {"const": 1},
    "ui_stack": {"enum": ["ugui", "ngui", "ui-toolkit"]},
    "source_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "motions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/motion"}
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_. -]+(?:/[A-Za-z0-9_. -]+)*$"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alpha": {"type": "number", "minimum": 0, "maximum": 1},
        "scale": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
        "offset": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
        "rotation": {"type": "number"},
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6,8}$"}
      },
      "minProperties": 1
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "target", "trigger", "interruption", "start_state", "end_state",
        "duration_ms", "easing", "reverse", "reduced_motion", "driver",
        "dependency_evidence", "unity_target", "verification", "budget_ms"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "target": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "trigger": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "interruption": {"enum": ["restart", "complete", "ignore", "reverse"]},
        "start_state": {"$ref": "#/$defs/state"},
        "end_state": {"$ref": "#/$defs/state"},
        "duration_ms": {"type": "integer", "exclusiveMinimum": 0},
        "easing": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "reverse": {"type": "boolean"},
        "reduced_motion": {"enum": ["snap-to-end", "disable", "preserve"]},
        "driver": {"enum": ["animator", "animation-clip", "ngui-tween", "uss-transition", "project-controller", "dotween", "leantween"]},
        "dependency_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "unity_target": {"$ref": "#/$defs/path"},
        "verification": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "budget_ms": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
