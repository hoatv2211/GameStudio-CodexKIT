{
  "$comment": "Generated by scripts/sync_skill_resources.py. Do not edit manually.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/capture-plan.schema.json",
  "title": "Game screenshot capture plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "project",
    "flows",
    "scene_path",
    "entry_point",
    "checkpoint",
    "viewport",
    "locale",
    "timeout_seconds",
    "reviewer_approval"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "root",
        "source_revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        },
        "root": {
          "$ref": "#/$defs/path"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        }
      }
    },
    "flows": {
      "$comment": "Semantic uniqueness for flow_id and order is enforced by scripts.screenshot_showcase.validate_payload.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "scene_path": {
      "$ref": "#/$defs/path"
    },
    "entry_point": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "timeout_seconds": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "reviewer_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "reviewer",
        "approved_at"
      ],
      "properties": {
        "approved": {
          "const": true
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        },
        "approved_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*))*$"
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "flow_id",
        "scene_path",
        "entry_point",
        "checkpoint"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "flow_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "scene_path": {
          "$ref": "#/$defs/path"
        },
        "entry_point": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\r\\n](?:[\\S ]*[^\\s\\r\\n])?$"
        }
      }
    }
  }
}
