{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/ui-art-qc-report.schema.json",
  "title": "Unity UI static art QC report",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "design_brief", "source_revision", "asset_count", "checks", "failures", "limitations"],
  "properties": {
    "verdict": {"enum": ["PASS", "FAIL"]},
    "design_brief": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "source_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "asset_count": {"type": "integer", "minimum": 0},
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/check"}
    },
    "failures": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]},
      "then": {"properties": {"failures": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "FAIL"}}, "required": ["verdict"]},
      "then": {"properties": {"failures": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "format", "width", "height", "sha256", "has_alpha", "alpha_checked"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "format": {"enum": ["png", "svg", "jpg"]},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "has_alpha": {"type": ["boolean", "null"]},
        "alpha_checked": {"type": "boolean"},
        "bit_depth": {"type": "integer", "minimum": 1},
        "color_type": {"type": "integer", "minimum": 0, "maximum": 6},
        "components": {"type": "integer", "minimum": 1},
        "precision": {"type": "integer", "minimum": 1}
      }
    }
  }
}
