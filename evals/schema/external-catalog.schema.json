{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/external-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["external_skills", "cases"],
  "properties": {
    "external_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "expected_skill", "must_beat"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "prompt": {"type": "string", "minLength": 1},
          "expected_skill": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "must_beat": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          }
        }
      }
    }
  }
}
