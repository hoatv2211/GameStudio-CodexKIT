{
  "$comment": "Generated by scripts/sync_skill_resources.py. Do not edit manually.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio-codexkit.local/schema/ui-asset-manifest.schema.json",
  "title": "Unity UI art asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ui_stack",
    "figma",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ui_stack": {
      "enum": [
        "ugui",
        "ngui",
        "ui-toolkit"
      ]
    },
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "page_id",
        "source_revision",
        "captured_at"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_. -]+(?:/[A-Za-z0-9_. -]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_id",
        "ai_provenance",
        "export_path",
        "export_sha256",
        "unity_target",
        "kind",
        "format",
        "width",
        "height",
        "scale",
        "alpha",
        "color_space",
        "pixels_per_unit",
        "pivot",
        "atlas_group",
        "compression",
        "owner",
        "reviewer",
        "limitations",
        "restore_source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ai_provenance": {
          "$ref": "#/$defs/ai_provenance"
        },
        "export_path": {
          "$ref": "#/$defs/path"
        },
        "export_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "unity_target": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "enum": [
            "sprite",
            "nine-slice",
            "icon",
            "background",
            "font-asset",
            "vector"
          ]
        },
        "format": {
          "enum": [
            "png",
            "svg",
            "jpg"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alpha": {
          "type": "boolean"
        },
        "color_space": {
          "enum": [
            "srgb",
            "linear"
          ]
        },
        "pixels_per_unit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pivot": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "items": false
        },
        "borders": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "items": false
        },
        "atlas_group": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "compression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "restore_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "nine-slice"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "borders"
            ]
          }
        }
      ]
    },
    "ai_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "prompt",
        "reference_sha256",
        "output_sha256",
        "reviewer"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reference_sha256": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
